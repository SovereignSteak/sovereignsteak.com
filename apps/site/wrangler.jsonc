{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sovereignsteak",
  "main": "./src/index.js",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["contact@sovereignsteak.com"]
    }
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "sovereignsteak.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
